# API base URL (use /api when the SPA is served by the Nginx container).
VITE_API_URL=http://localhost:5080/api

# Dev/demo only. Show the demo credential block on the login page.
VITE_SHOW_DEMO_CREDENTIALS=true
# These should mirror SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD in the root .env.
VITE_DEMO_EMAIL=admin@assettagbd.local
VITE_DEMO_PASSWORD=Admin@123
# Set true only when SEED_SAMPLE_DATA=true so the manager/employee accounts exist.
VITE_DEMO_SAMPLE=false
