# Copy to .env and replace every value before deploying.
POSTGRES_DB=assettagbd
# Keep this consistent with the Username in secrets/db_connection.txt.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

API_PORT=5080
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
ASPNETCORE_ENVIRONMENT=Production

# MUST be at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=AssetTagBD
JWT_AUDIENCE=AssetTagBD
JWT_EXPIRY_MINUTES=480

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_SAMPLE_DATA=false

# Dev/demo only: return the password-reset token in the API response.
# Never enable in production — configure SMTP instead.
AUTH_EXPOSE_RESET_TOKEN=false

# Email for password resets (production). Put the SMTP password in
# secrets/smtp_password.txt when using docker-compose.prod.yml.
EMAIL_FROM=noreply@yourcompany.com
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_USE_SSL=false
